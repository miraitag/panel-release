{
  "name": "release-panel",
  "private": true,
  "version": "0.1.0",
  "description": "Panel para versionar librerías React Native (Bitbucket → Jenkins → Artifactory) y actualizar el wrapper brownfield.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @release-panel/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
