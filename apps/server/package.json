    "semver": "^7.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.7.1",
    "pino-pretty": "^13.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
