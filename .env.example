# ─────────────────────────────────────────────────────────────
# Release Panel · variables de entorno (copia a .env)
# ─────────────────────────────────────────────────────────────

# Modo demo: usa adaptadores falsos (no toca Bitbucket, git ni Artifactory).
MOCK_MODE=true

# Servidor
HOST=127.0.0.1
PORT=4310
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Catálogo de librerías y wrapper
LIBRARIES_CONFIG=./config/libraries.config.json

# Carpetas de trabajo (clones temporales y bitácora de auditoría)
WORK_DIR=./.work
AUDIT_DIR=./.audit

# Artifactory (registry npm)  [CONFIRMAR token vs usuario + API key]
ARTIFACTORY_NPM_URL=https://[ARTIFACTORY_HOST]/artifactory/api/npm/[NPM_REPO]/
ARTIFACTORY_TOKEN=

# Bitbucket: cloud | datacenter  [CONFIRMAR]
BITBUCKET_FLAVOR=cloud
# Cloud: https://api.bitbucket.org/2.0  ·  Data Center: https://bitbucket.tu-empresa.com
BITBUCKET_API_URL=https://api.bitbucket.org/2.0
# Cloud: workspace  ·  Data Center: clave del proyecto
BITBUCKET_WORKSPACE=[WORKSPACE]
BITBUCKET_TOKEN=
BITBUCKET_MAIN_BRANCH=main
# Plantilla del remoto git; {workspace} y {repo} se reemplazan
GIT_REMOTE_TEMPLATE=git@bitbucket.org:{workspace}/{repo}.git

# Identidad de los commits del bot
GIT_AUTHOR_NAME=Release Panel
GIT_AUTHOR_EMAIL=release-panel@example.com

# Formato del tag que dispara Jenkins  [CONFIRMAR]: v{version} | {name}@{version}
TAG_FORMAT=v{version}

# Espera a que Jenkins publique en Artifactory
POLL_INTERVAL_MS=30000
POLL_ATTEMPTS=40
